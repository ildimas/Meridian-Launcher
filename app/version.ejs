<div id="versionContainer" class="sheetView" style="display: none;">
    <header class="sheetHeader">
        <button id="versionBack" class="packRoundButton" aria-label="<%- lang('pack.back') %>" title="<%- lang('pack.back') %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <div class="sheetHeading">
            <span class="sheetTitle"><%- lang('version.title') %></span>
            <span class="sheetDesc"><%- lang('version.desc') %></span>
        </div>
    </header>
    <div id="versionBody" class="sheetBody">
        <%# The install progress (#mpTask) moves in here while an install runs from this view. %>
        <div class="mpCard" id="mpVersion">
            <div class="apSegment" id="mpLoader">
                <button value="vanilla" selected>Vanilla</button>
                <button value="fabric">Fabric</button>
                <button value="quilt">Quilt</button>
                <button value="forge">Forge</button>
                <button value="neoforge">NeoForge</button>
            </div>
            <div class="mpFiles" id="mpFiles">
                <button type="button" class="apLink" id="mpFilesPick"><%- lang('settings.modpacksFilesAdd') %></button>
                <div class="mpFilesChip" id="mpFilesChip" hidden>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/></svg>
                    <span class="mpFilesText">
                        <span id="mpFilesName"></span>
                        <span id="mpFilesNote"></span>
                    </span>
                    <button type="button" id="mpFilesClear" title="<%- lang('settings.modpacksFilesClear') %>" aria-label="<%- lang('settings.modpacksFilesClear') %>">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>
                    </button>
                </div>
            </div>
            <div class="mpFormRow">
                <label class="mpField">
                    <span><%- lang('settings.modpacksMinecraft') %></span>
                    <select id="mpMinecraft" class="mpSelect"></select>
                </label>
                <label class="mpField" id="mpLoaderVersionField" hidden>
                    <span><%- lang('settings.modpacksLoaderVersion') %></span>
                    <select id="mpLoaderVersion" class="mpSelect"></select>
                </label>
            </div>
            <div class="mpFormRow">
                <label class="mpField mpFieldGrow">
                    <span><%- lang('settings.modpacksName') %></span>
                    <input type="text" id="mpName" spellcheck="false">
                </label>
                <button id="mpVersionInstall" class="mpButton"><%- lang('settings.modpacksInstall') %></button>
            </div>
        </div>
    </div>
</div>
