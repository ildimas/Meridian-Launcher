<div id="settingsContainer" style="display: none;">
    <div id="settingsContainerLeft">
        <div id="settingsNavContainer">
            <div id="settingsNavHeader">
                <span id="settingsNavHeaderText"><%- lang('settings.navHeaderText') %></span>
            </div>
            <div id="settingsNavItemsContainer">
                <div id="settingsNavItemsContent">
                    <button class="settingsNavItem" rSc="settingsTabAccount" id="settingsNavAccount" selected><%- lang('settings.navAccount') %></button>
                    <button class="settingsNavItem" rSc="settingsTabModpacks"><%- lang('settings.navModpacks') %></button>
                    <button class="settingsNavItem" rSc="settingsTabMinecraft"><%- lang('settings.navMinecraft') %></button>
                    <button class="settingsNavItem" rSc="settingsTabAppearance" id="settingsNavAppearance"><%- lang('settings.navAppearance') %></button>
                    <button class="settingsNavItem" rSc="settingsTabLauncher"><%- lang('settings.navLauncher') %></button>
                    <div class="settingsNavSpacer"></div>
                    <button class="settingsNavItem" rSc="settingsTabAbout" id="settingsNavAbout"><%- lang('settings.navAbout') %></button>
                    <div id="settingsNavContentBottom">
                        <div class="settingsNavDivider"></div>
                        <button id="settingsNavDone"><%- lang('settings.navDone') %></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="settingsContainerRight">
        <div id="settingsTabAccount" class="settingsTab">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.tabAccountHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.tabAccountHeaderDesc') %></span>
            </div>
            <div class="settingsAuthAccountTypeContainer">
                <div class="settingsAuthAccountTypeHeader">
                    <div class="settingsAuthAccountTypeHeaderLeft">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 23 23">
                            <path fill="#f35325" d="M1 1h10v10H1z" />
                            <path fill="#81bc06" d="M12 1h10v10H12z" />
                            <path fill="#05a6f0" d="M1 12h10v10H1z" />
                            <path fill="#ffba08" d="M12 12h10v10H12z" />
                        </svg>
                        <span><%- lang('settings.microsoftAccount') %></span>
                    </div>
                    <div class="settingsAuthAccountTypeHeaderRight">
                        <button class="settingsAddAuthAccount" id="settingsAddMicrosoftAccount"><%- lang('settings.addMicrosoftAccount') %></button>
                    </div>
                </div>
                
                <div class="settingsCurrentAccounts" id="settingsCurrentMicrosoftAccounts">
                    <!-- Microsoft auth accounts populated here. -->
                </div>
            </div>

            <div class="settingsAuthAccountTypeContainer">
                <div class="settingsAuthAccountTypeHeader">
                    <div class="settingsAuthAccountTypeHeaderLeft">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 9.677 9.667">
                            <path d="M-26.332-12.098h2.715c-1.357.18-2.574 1.23-2.715 2.633z" fill="#fff" />
                            <path d="M2.598.022h7.07L9.665 7c-.003 1.334-1.113 2.46-2.402 2.654H0V2.542C.134 1.2 1.3.195 2.598.022z" fill="#db2331" />
                            <path d="M1.54 2.844c.314-.76 1.31-.46 1.954-.528.785-.083 1.503.272 2.1.758l.164-.9c.327.345.587.756.964 1.052.28.254.655-.342.86-.013.42.864.408 1.86.54 2.795l-.788-.373C6.9 4.17 5.126 3.052 3.656 3.685c-1.294.592-1.156 2.65.06 3.255 1.354.703 2.953.51 4.405.292-.07.42-.34.87-.834.816l-4.95.002c-.5.055-.886-.413-.838-.89l.04-4.315z" fill="#fff" />
                        </svg>
                        <span><%- lang('settings.mojangAccount') %></span>
                    </div>
                    <div class="settingsAuthAccountTypeHeaderRight">
                        <button class="settingsAddAuthAccount" id="settingsAddMojangAccount"><%- lang('settings.addMojangAccount') %></button>
                    </div>
                </div>
                
                <div class="settingsCurrentAccounts" id="settingsCurrentMojangAccounts">
                    <!-- Mojang auth accounts populated here. -->
                </div>
            </div>

            <div class="settingsAuthAccountTypeContainer">
                <div class="settingsAuthAccountTypeHeader">
                    <div class="settingsAuthAccountTypeHeaderLeft">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 12a4 4 0 1 0 0-8a4 4 0 0 0 0 8z M4.5 20c1.4-3.3 4.2-5 7.5-5s6.1 1.7 7.5 5"/>
                        </svg>
                        <span><%- lang('settings.offlineAccount') %></span>
                    </div>
                    <div class="settingsAuthAccountTypeHeaderRight">
                        <button class="settingsAddAuthAccount" id="settingsAddOfflineAccount"><%- lang('settings.addOfflineAccount') %></button>
                    </div>
                </div>

                <div class="settingsCurrentAccounts" id="settingsCurrentOfflineAccounts">
                    <!-- Offline accounts populated here. -->
                </div>
            </div>
        </div>
        <div id="settingsTabModpacks" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.modpacksHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.modpacksHeaderDesc') %></span>
            </div>
            <div id="mpContainer">
                <div id="mpTask" hidden>
                    <div class="mpTaskHead">
                        <span id="mpTaskTitle"></span>
                        <span id="mpTaskPercent"></span>
                    </div>
                    <div class="mpTaskBar"><span id="mpTaskFill"></span></div>
                    <div class="mpTaskFoot">
                        <div id="mpTaskDetail"></div>
                        <button class="apLink" id="mpTaskSecondary" hidden></button>
                        <button class="apLink" id="mpTaskAction" hidden></button>
                    </div>
                </div>

                <div class="settingsModsHeader"><%- lang('settings.modpacksBrowse') %></div>
                <div id="mpBrowseBar">
                    <div class="apSegment" id="mpSource">
                        <button value="modrinth" selected>Modrinth</button>
                        <button value="curseforge">CurseForge</button>
                    </div>
                    <label id="mpSearch">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 18a7 7 0 1 0 0-14a7 7 0 0 0 0 14z M20 20l-4-4"/></svg>
                        <input type="text" id="mpSearchInput" spellcheck="false" placeholder="<%- lang('settings.modpacksSearch') %>">
                    </label>
                    <button id="mpImport" class="mpButton mpButtonQuiet" title="<%- lang('settings.modpacksImportDesc') %>">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 19h14"/></svg>
                        <span><%- lang('settings.modpacksImportButton') %></span>
                    </button>
                </div>
                <div id="mpCategoryBar">
                    <div id="mpCategories" role="group"></div>
                    <div id="mpLinks">
                        <button id="mpKeyEdit" class="apLink" hidden></button>
                        <button id="mpSite" class="apLink"></button>
                    </div>
                </div>
                <div id="mpCurseForgeKey" class="mpCard" hidden>
                    <span class="mpCardTitle"><%- lang('settings.modpacksCfKeyTitle') %></span>
                    <span class="mpCardDesc"><%- lang('settings.modpacksCfKeyDesc') %></span>
                    <div class="mpFormRow">
                        <input type="text" id="mpCurseForgeKeyInput" class="mpFieldGrow" spellcheck="false" placeholder="$2a$10$…">
                        <button id="mpCurseForgeKeySave" class="mpButton"><%- lang('settings.modpacksCfKeySave') %></button>
                    </div>
                </div>
                <div id="mpResults" class="settingsPackList" role="list"></div>
                <button id="mpMore" class="mpButton mpButtonQuiet" hidden><%- lang('settings.modpacksMore') %></button>
            </div>
        </div>
        <div id="settingsTabMinecraft" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.minecraftTabHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.minecraftTabHeaderDesc') %></span>
            </div>
            <section class="packGroup" data-game-group="memory">
                <div class="packGroupHead">
                    <div class="settingsFieldLeft">
                        <span class="settingsFieldTitle"><%- lang('settings.gameMemoryTitle') %></span>
                        <span class="settingsFieldDesc packGroupState"></span>
                    </div>
                    <label class="packOwn">
                        <span><%- lang('settings.gameDefaultOwn') %></span>
                        <span class="toggleSwitch">
                            <input type="checkbox" class="packOwnToggle">
                            <span class="toggleSwitchSlider"></span>
                        </span>
                    </label>
                </div>
                <div class="packGroupBody">
                    <%- include('memoryControl', { id: 'gameMemory' }) %>
                </div>
            </section>
            <section class="packGroup" data-game-group="jvm">
                <div class="packGroupHead">
                    <div class="settingsFieldLeft">
                        <span class="settingsFieldTitle"><%- lang('settings.gameJvmTitle') %></span>
                        <span class="settingsFieldDesc packGroupState"></span>
                    </div>
                    <label class="packOwn">
                        <span><%- lang('settings.gameDefaultOwn') %></span>
                        <span class="toggleSwitch">
                            <input type="checkbox" class="packOwnToggle">
                            <span class="toggleSwitchSlider"></span>
                        </span>
                    </label>
                </div>
                <div class="packGroupBody">
                    <input type="text" id="gameJVMOptsVal" class="gameJvmInput" spellcheck="false" aria-label="<%- lang('settings.gameJvmTitle') %>">
                    <span class="settingsFieldDesc"><%- lang('settings.jvmOptsDesc') %></span>
                </div>
            </section>
            <div class="settingsFieldContainer" id="gameGpuField">
                <div class="settingsFieldLeft">
                    <span class="settingsFieldTitle"><%- lang('gpu.title') %></span>
                    <span class="settingsFieldDesc"><%- lang('gpu.desc') %></span>
                </div>
                <div class="settingsFieldRight">
                    <%- include('gpuControl', { id: 'gameGpu' }) %>
                </div>
            </div>
            <div id="settingsGameResolutionContainer">
                <span class="settingsFieldTitle"><%- lang('settings.gameResolutionTitle') %></span>
                <div id="settingsGameResolutionContent">
                    <input type="number" id="settingsGameWidth" min="0" cValue="GameWidth">
                    <div id="settingsGameResolutionCross">&#10006;</div>
                    <input type="number" id="settingsGameHeight" min="0" cValue="GameHeight">
                </div>
            </div>
            <div class="settingsFieldContainer">
                <div class="settingsFieldLeft">
                    <span class="settingsFieldTitle"><%- lang('settings.launchFullscreenTitle') %></span>
                </div>
                <div class="settingsFieldRight">
                    <label class="toggleSwitch">
                        <input type="checkbox" cValue="Fullscreen">
                        <span class="toggleSwitchSlider"></span>
                    </label>
                </div>
            </div>
            <div class="settingsFieldContainer">
                <div class="settingsFieldLeft">
                    <span class="settingsFieldTitle"><%- lang('settings.autoConnectTitle') %></span>
                </div>
                <div class="settingsFieldRight">
                    <label class="toggleSwitch">
                        <input type="checkbox" cValue="AutoConnect">
                        <span class="toggleSwitchSlider"></span>
                    </label>
                </div>
            </div>
            <div class="settingsFieldContainer">
                <div class="settingsFieldLeft">
                    <span class="settingsFieldTitle"><%- lang('settings.launchDetachedTitle') %></span>
                    <span class="settingsFieldDesc"><%- lang('settings.launchDetachedDesc') %></span>
                </div>
                <div class="settingsFieldRight">
                    <label class="toggleSwitch">
                        <input type="checkbox" cValue="LaunchDetached">
                        <span class="toggleSwitchSlider"></span>
                    </label>
                </div>
            </div>
            <div class="settingsFieldContainer">
                <div class="settingsFieldLeft">
                    <span class="settingsFieldTitle"><%- lang('settings.backupWorldsTitle') %></span>
                    <span class="settingsFieldDesc"><%- lang('settings.backupWorldsDesc') %></span>
                </div>
                <div class="settingsFieldRight">
                    <label class="toggleSwitch">
                        <input type="checkbox" cValue="BackupWorlds">
                        <span class="toggleSwitchSlider"></span>
                    </label>
                </div>
            </div>
        </div>
        <div id="settingsTabAppearance" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.appearanceHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.appearanceHeaderDesc') %></span>
            </div>
            <div class="apLayout">
                <div class="apMain">
                    <div class="apField">
                        <div class="apFieldRow">
                            <span class="settingsFieldTitle"><%- lang('settings.appearanceIntervalTitle') %></span>
                            <div class="apSegment" id="apInterval">
                                <button value="15"><%- lang('settings.appearanceInterval15') %></button>
                                <button value="30"><%- lang('settings.appearanceInterval30') %></button>
                                <button value="60"><%- lang('settings.appearanceInterval60') %></button>
                                <button value="300"><%- lang('settings.appearanceInterval300') %></button>
                            </div>
                        </div>
                    </div>
                    <div class="apField">
                        <div class="apFieldRow">
                            <div class="settingsFieldLeft">
                                <span class="settingsFieldTitle"><%- lang('settings.appearanceMotionTitle') %></span>
                                <span class="settingsFieldDesc"><%- lang('settings.appearanceMotionDesc') %></span>
                            </div>
                            <label class="toggleSwitch">
                                <input type="checkbox" id="apMotion">
                                <span class="toggleSwitchSlider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="apField">
                        <div class="apFieldRow">
                            <div class="settingsFieldLeft">
                                <span class="settingsFieldTitle"><%- lang('settings.appearanceSplashTitle') %></span>
                                <span class="settingsFieldDesc"><%- lang('settings.appearanceSplashDesc') %></span>
                            </div>
                            <label class="toggleSwitch">
                                <input type="checkbox" id="apSplash">
                                <span class="toggleSwitchSlider"></span>
                            </label>
                        </div>
                    </div>
                    <span class="apCaps"><%- lang('settings.appearancePacksTitle') %></span>
                    <div class="apPackList" id="apPackList" role="list">
                        <!-- One row per modpack. -->
                    </div>
                </div>
                <div class="apPreview">
                    <div class="apPreviewFrame" id="apPreviewFrame">
                        <span class="apPreviewLabel" id="apPreviewLabel" hidden></span>
                    </div>
                    <div class="apPreviewFoot">
                        <span class="apPreviewCaption" id="apPreviewCaption"></span>
                        <span class="apDots" id="apPreviewDots"></span>
                    </div>
                </div>
            </div>
            <section class="settingsSection" id="settingsSectionFolders" aria-labelledby="mpFoldersTitle">
                <div class="settingsSectionHeader">
                    <span class="settingsSectionTitle" id="mpFoldersTitle"><%- lang('settings.foldersTitle') %></span>
                    <span class="settingsSectionDesc"><%- lang('settings.foldersSubtitle') %></span>
                </div>
                <div id="mpFolders">
                    <form id="mpFolderCreate" class="mpFormRow">
                        <label class="mpField mpFieldGrow" for="mpFolderName">
                            <span id="mpFolderCreateLabel"><%- lang('settings.folderNew') %></span>
                            <input id="mpFolderName" type="text" maxlength="60" required aria-label="<%- lang('settings.folderName') %>" placeholder="<%- lang('settings.folderPlaceholder') %>">
                        </label>
                        <button class="mpButton" id="mpFolderCreateButton" type="submit" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><%- lang('settings.folderCreate') %></button>
                    </form>
                    <p id="mpFolderSource" class="mpFolderHint"></p>
                    <p id="mpFolderError" role="alert" hidden></p>
                    <div class="mpFolderSummary"><span id="mpFolderHeading"></span><span id="mpFolderTotal"></span></div>
                    <div id="mpFolderList"></div>
                    <p class="mpFolderHint"><%- lang('settings.foldersHint') %></p>
                </div>
            </section>
            <section class="settingsSection" id="settingsSectionLanguage">
                <div class="settingsSectionHeader">
                    <span class="settingsSectionTitle"><%- lang('settings.languageHeaderText') %></span>
                    <span class="settingsSectionDesc"><%- lang('settings.languageHeaderDesc') %></span>
                </div>
                <div id="langCurrent">
                    <img id="langCurrentFlag" class="langFlag" alt="">
                    <div id="langCurrentText">
                        <div id="langCurrentTitle">
                            <span id="langCurrentName"></span>
                            <span id="langCurrentMeta"></span>
                        </div>
                        <div id="langCurrentStatus">
                            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5"/></svg>
                            <span id="langCurrentStatusText"><%- lang('settings.languageApplied') %></span>
                        </div>
                    </div>
                </div>
                <div id="langOptions">
                    <div class="settingsFieldContainer">
                        <div class="settingsFieldLeft">
                            <span class="settingsFieldTitle"><%- lang('settings.languageSystemTitle') %></span>
                            <span class="settingsFieldDesc" id="langSystemDesc"></span>
                        </div>
                        <label class="toggleSwitch">
                            <input type="checkbox" id="langSystemToggle">
                            <span class="toggleSwitchSlider"></span>
                        </label>
                    </div>
                    <div class="settingsFieldContainer">
                        <div class="settingsFieldLeft">
                            <span class="settingsFieldTitle"><%- lang('settings.languageMinecraftTitle') %></span>
                            <span class="settingsFieldDesc" id="langMinecraftDesc"></span>
                        </div>
                        <label class="toggleSwitch">
                            <input type="checkbox" id="langMinecraftToggle">
                            <span class="toggleSwitchSlider"></span>
                        </label>
                    </div>
                </div>
                <div id="langAllHead">
                    <div class="settingsFieldLeft">
                        <span class="apSectionTitle"><%- lang('settings.languageAllTitle') %></span>
                        <span class="settingsFieldDesc"><%- lang('settings.languageAllDesc') %></span>
                    </div>
                    <label id="langSearch">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
                        <input type="search" id="langSearchInput" placeholder="<%- lang('settings.languageSearch') %>" spellcheck="false">
                    </label>
                </div>
                <div id="langList" role="radiogroup" aria-label="<%- lang('settings.languageAllTitle') %>"></div>
                <div id="langEmpty"></div>
                <div id="langFooter">
                    <span><%- lang('settings.languageFooter') %></span>
                    <a id="langHelpButton" href="<%- lang('settings.sourceGithubLink') %>/tree/master/app/assets/lang"><%- lang('settings.languageHelp') %></a>
                </div>
            </section>
        </div>
        <div id="settingsTabLauncher" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.launcherTabHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.launcherTabHeaderDesc') %></span>
            </div>
            <div class="settingsFieldContainer">
                <div class="settingsFieldLeft">
                    <span class="settingsFieldTitle"><%- lang('settings.hardwareAccelerationTitle') %></span>
                    <span class="settingsFieldDesc"><%- lang('settings.hardwareAccelerationDesc') %></span>
                </div>
                <div class="settingsFieldRight">
                    <label class="toggleSwitch">
                        <input type="checkbox" cValue="HardwareAcceleration">
                        <span class="toggleSwitchSlider"></span>
                    </label>
                </div>
            </div>
            <div class="settingsFileSelContainer">
                <div class="settingsFileSelContent">
                    <div class="settingsFieldTitle" id="settingsDataDirTitle"><%- lang('settings.dataDirectoryTitle') %></div>
                    <div class="settingsFileSelActions">
                        <div class="settingsFileSelIcon">
                            <svg class="settingsFileSelSVG">
                                <g>
                                    <path fill="gray" d="m10.044745,5c0,0.917174 -0.746246,1.667588 -1.667588,1.667588l-4.168971,0l-2.501382,0c-0.921009,0 -1.667588,0.750415 -1.667588,1.667588l0,6.670353l0,2.501382c0,0.917174 0.746604,1.667588 1.667588,1.667588l16.675882,0c0.921342,0 1.667588,-0.750415 1.667588,-1.667588l0,-2.501382l0,-8.337941c0,-0.917174 -0.746246,-1.667588 -1.667588,-1.667588l-8.337941,0z"/>
                                    <path fill="gray" d="m1.627815,1.6c-0.921009,0 -1.667588,0.746579 -1.667588,1.667588l0,4.168971l8.337941,0l0,0.833794l11.673118,0l0,-4.168971c0,-0.921009 -0.746246,-1.667588 -1.667588,-1.667588l-8.572237,0c-0.288493,-0.497692 -0.816284,-0.833794 -1.433292,-0.833794l-6.670353,0z"/>
                                    <path fill="lightgray" d="m10.025276,4c0,0.918984 -0.747719,1.670879 -1.670879,1.670879l-4.177198,0l-2.506319,0c-0.922827,0 -1.670879,0.751896 -1.670879,1.670879l0,6.683517l0,2.506319c0,0.918984 0.748078,1.670879 1.670879,1.670879l16.708794,0c0.923161,0 1.670879,-0.751896 1.670879,-1.670879l0,-2.506319l0,-8.354397c0,-0.918984 -0.747719,-1.670879 -1.670879,-1.670879l-8.354397,0z"/>
                                </g>
                            </svg>
                        </div>
                        <input class="settingsFileSelVal" type="text" value="null" cValue="DataDirectory" disabled>
                        <button class="settingsFileSelButton" dialogTitle="<%- lang('settings.selectDataDirectory') %>" dialogDirectory="true"><%- lang('settings.chooseFolder') %></button>
                    </div>
                </div>
                <div class="settingsFileSelDesc"><%- lang('settings.dataDirectoryDesc') %></div>
            </div>
            <div id="settingsDistroUrl">
                <span class="settingsFieldTitle"><%- lang('settings.distroUrlTitle') %></span>
                <span class="settingsFieldDesc"><%- lang('settings.distroUrlDesc') %></span>
                <div class="settingsDistroUrlRow">
                    <input type="text" id="settingsDistroUrlInput" spellcheck="false">
                    <button id="settingsDistroUrlApply" class="mpButton"><%- lang('settings.distroUrlApply') %></button>
                    <button id="settingsDistroUrlReset" class="mpButton settingsDistroUrlReset"><%- lang('settings.distroUrlReset') %></button>
                </div>
                <div class="settingsDistroUrlWarn" role="alert">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l10 18H2zM12 10v5M12 18v.01"/></svg>
                    <span><%- lang('settings.distroUrlWarn') %></span>
                </div>
                <span id="settingsDistroUrlStatus" class="settingsDistroUrlStatus" hidden></span>
            </div>
            <section class="settingsSection" id="settingsSectionProxy">
                <div class="settingsSectionHeader">
                    <span class="settingsSectionTitle"><%- lang('settings.navProxy') %></span>
                    <span class="settingsSectionDesc"><%- lang('settings.proxyTabHeaderDesc') %></span>
                </div>
                <div class="settingsProxyContainer">
                    <%- include('proxyForm', { formId: 'settingsProxyForm' }) %>
                </div>
            </section>
        </div>
        <div id="settingsTabAbout" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.aboutTabHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.aboutTabHeaderDesc') %></span>
            </div>
            <div id="settingsAboutCurrentContainer">
                <div id="settingsAboutCurrentContent">
                    <div id="settingsAboutCurrentHeadline">
                        <img id="settingsAboutLogo" src="./assets/images/logo.svg">
                        <span id="settingsAboutTitle"><%- lang('settings.aboutTitle', { appName: lang('app.title') }) %></span>
                    </div>
                    <div id="settingsAboutCurrentVersion">
                        <div id="settingsAboutCurrentVersionCheck">&#10003;</div>
                        <div id="settingsAboutCurrentVersionDetails">
                            <span id="settingsAboutCurrentVersionTitle"><%- lang('settings.stableRelease') %></span>
                            <div id="settingsAboutCurrentVersionLine">
                                <span id="settingsAboutCurrentVersionText"><%- lang('settings.versionText') %></span>
                                <span id="settingsAboutCurrentVersionValue">0.0.1-alpha.18</span>
                            </div>
                        </div>
                        <div id="settingsUpdateStatus">
                            <span id="settingsUpdateTitle"><!-- You Are Running the Latest Version --></span>
                            <button id="settingsUpdateActionButton"><%- lang('settings.checkForUpdates') %></button>
                        </div>
                    </div>
                </div>
                <div id="settingsAboutButtons">
                    <a href="<%- lang('settings.sourceGithubLink') %>" id="settingsAboutSourceButton" class="settingsAboutButton"><%- lang('settings.sourceGithub') %></a>
                    <!-- The following must be included in third-party usage. -->
                    <!-- <a href="https://github.com/dscalzi/HeliosLauncher" id="settingsAboutSourceButton" class="settingsAboutButton">Original Source</a> -->
                    <a href="<%- lang('settings.supportLink') %>" id="settingsAboutSupportButton" class="settingsAboutButton"><%- lang('settings.support') %></a>
                    <a href="#" id="settingsAboutDevToolsButton" class="settingsAboutButton"><%- lang('settings.devToolsConsole') %></a>
                </div>
            </div>
            <div class="settingsFieldContainer" id="settingsPrereleaseField">
                <div class="settingsFieldLeft">
                    <span class="settingsFieldTitle"><%- lang('settings.allowPrereleaseTitle') %></span>
                    <span class="settingsFieldDesc"><%- lang('settings.allowPrereleaseDesc') %></span>
                </div>
                <div class="settingsFieldRight">
                    <label class="toggleSwitch">
                        <input type="checkbox" cValue="AllowPrerelease">
                        <span class="toggleSwitchSlider"></span>
                    </label>
                </div>
            </div>
            <div class="settingsChangelogContainer">
                <div class="settingsChangelogContent">
                    <div class="settingsChangelogHeadline">
                        <div class="settingsChangelogLabel"><%- lang('settings.releaseNotes') %></div>
                        <div class="settingsChangelogTitle"><%- lang('settings.changelog') %></div>
                    </div>
                    <div class="settingsChangelogText">
                        <%- lang('settings.noReleaseNotes') %>
                    </div>
                </div>
                <div class="settingsChangelogActions">
                    <a class="settingsChangelogButton settingsAboutButton" href="<%- lang('settings.sourceGithubLink') %>/releases"><%- lang('settings.viewReleaseNotes') %></a>
                </div>
            </div>
        </div>
        <div id="apDrawerScrim"></div>
        <aside id="apDrawer" role="dialog" aria-modal="true" aria-labelledby="apDrawerName" aria-hidden="true">
            <div class="apDrawerHead">
                <span class="serverListTile" id="apDrawerTile"></span>
                <div class="apDrawerTitle">
                    <span id="apDrawerName"></span>
                    <span id="apDrawerSub"></span>
                </div>
                <button class="apDrawerClose" id="apDrawerClose" aria-label="<%- lang('settings.appearanceDrawerClose') %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>
            <div class="apDrawerBody">
                <div class="apGroupHead">
                    <span class="apGroupTitle"><b id="apArtTitle"></b> <span id="apArtCount"></span></span>
                    <button class="apLink" id="apArtAll"><%- lang('settings.appearanceShowAll') %></button>
                </div>
                <div class="apShotGrid" id="apArtGrid"></div>
                <div class="apGroupHead">
                    <span class="apGroupTitle"><b><%- lang('settings.appearanceShotsTitle') %></b> <span id="apShotCount"></span></span>
                    <button class="apLink" id="apShotsFolder"><%- lang('settings.appearanceShotsFolder') %></button>
                </div>
                <div class="apShotGrid" id="apShotGrid"></div>
                <span class="settingsFieldDesc" id="apShotEmpty" hidden><%- lang('settings.appearanceShotsEmpty') %></span>
            </div>
            <div class="apDrawerFoot">
                <button id="apDrawerDone"><%- lang('settings.appearanceDrawerDone') %></button>
            </div>
        </aside>
    </div>
    <script src="./assets/js/scripts/settings.js"></script>
    <script src="./assets/js/scripts/modpacks.js"></script>
</div>