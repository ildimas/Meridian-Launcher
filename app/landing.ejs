<div id="landingContainer" style="display: none;">
    <div id="upper">
        <div id="left">
            <div id="brandBlock">
                <div id="image_seal_container">
                    <img id="image_seal" src="assets/images/logo.svg" alt=""/>
                    <div id="updateAvailableTooltip"><%- lang('landing.updateAvailableTooltip') %></div>
                </div>
                <span id="brandName"><%= lang('app.title') %></span>
                <div id="mojangStatusWrapper" tabindex="0" aria-describedby="mojangStatusTooltip">
                    <span id="mojang_status_icon" data-label="<%- lang('landing.mojangStatusChecking') %>"></span>
                    <div id="mojangStatusTooltip" role="tooltip">
                        <div id="mojangStatusTooltipHead">
                            <span id="mojangStatusTooltipTitle"><%- lang('landing.mojangStatusTooltipTitle') %></span>
                            <span id="mojangStatusTooltipState"><%- lang('landing.mojangStatusChecking') %></span>
                        </div>
                        <div id="mojangStatusTooltipDesc"><%- lang('landing.mojangStatusTooltipDesc') %></div>
                        <div id="mojangStatusEssentialContainer">
                            <!-- Essential Mojang services are populated here. -->
                        </div>
                        <div id="mojangStatusNEContainer">
                            <div class="mojangStatusNEBar"></div>
                            <div id="mojangStatusNETitle"><%- lang('landing.mojangStatusNETitle') %></div>
                            <div class="mojangStatusNEBar"></div>
                        </div>
                        <div id="mojangStatusNonEssentialContainer">
                            <!-- Non Essential Mojang services are populated here. -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="right">
            <div id="rightContainer">
                <div id="topBar">
                    <button id="newsButton" class="topButton" aria-pressed="false">
                        <svg class="topButtonIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v14H5z M8 9h8 M8 12h8 M8 15h5"/></svg>
                        <span id="newsButtonText"><%- lang('landing.newsButton') %></span>
                        <span id="newsButtonAlert" style="display: none;"></span>
                    </button>
                    <button class="topButton topButtonSquare" id="settingsMediaButton" aria-label="<%- lang('landing.settingsTooltip') %>">
                        <svg id="settingsSVG" class="topButtonIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 1 0 0-6a3 3 0 0 0 0 6z"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
                        <span id="settingsTooltip"><%- lang('landing.settingsTooltip') %></span>
                    </button>
                    <div id="user_content">
                        <div id="avatarContainer">
                            <button id="avatarOverlay"><%- lang('landing.usernameEditButton') %></button>
                        </div>
                        <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
                    </div>
                </div>
                <!-- Every gallery wallpaper is credited to the player who took it. -->
                <button id="wallpaperCredit" hidden>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                    <span><%- lang('landing.wallpaperCreditBy') %> <span class="wallpaperCreditAuthor"></span></span>
                </button>
                <div id="mediaContent">
                    <div id="externalMedia">
                        <div class="mediaContainer">
                            <a href="<%- lang('landing.mediaGitHubURL') %>" class="mediaURL" id="linkURL">
                                <svg id="linkSVG" class="mediaSVG" viewBox="35.34 34.3575 70.68 68.71500">
                                    <g>
                                        <path d="M75.37,65.51a3.85,3.85,0,0,0-1.73.42,8.22,8.22,0,0,1,.94,3.76A8.36,8.36,0,0,1,66.23,78H46.37a8.35,8.35,0,1,1,0-16.7h9.18a21.51,21.51,0,0,1,6.65-8.72H46.37a17.07,17.07,0,1,0,0,34.15H66.23A17,17,0,0,0,82.77,65.51Z"/>
                                        <path d="M66,73.88a3.85,3.85,0,0,0,1.73-.42,8.22,8.22,0,0,1-.94-3.76,8.36,8.36,0,0,1,8.35-8.35H95A8.35,8.35,0,1,1,95,78H85.8a21.51,21.51,0,0,1-6.65,8.72H95a17.07,17.07,0,0,0,0-34.15H75.13A17,17,0,0,0,58.59,73.88Z"/>
                                    </g>
                                </svg>
                            </a>
                        </div>
                        <div class="mediaContainer">
                            <a href="<%- lang('landing.mediaXURL') %>" class="mediaURL" id="xURL">
                                <svg id="xSVG" class="mediaSVG" viewBox="0 0 275 275">
                                    <g>
                                        <path d="m236 0h46l-101 115 118 156h-92.6l-72.5-94.8-83 94.8h-46l107-123-113-148h94.9l65.5 86.6zm-16.1 244h25.5l-165-218h-27.4z"/>
                                    </g>
                                </svg>
                            </a>
                        </div>
                        <div class="mediaContainer">
                            <a href="<%- lang('landing.mediaInstagramURL') %>" class="mediaURL" id="instagramURL">
                                <svg id="instagramSVG" class="mediaSVG" viewBox="0 0 5040 5040">
                                    <defs>
                                        <radialGradient id="instaFill" cx="30%" cy="107%" r="150%">
                                            <stop offset="0%" stop-color="#fdf497"/>
                                            <stop offset="5%" stop-color="#fdf497"/>
                                            <stop offset="45%" stop-color="#fd5949"/>
                                            <stop offset="60%" stop-color="#d6249f"/>
                                            <stop offset="90%" stop-color="#285AEB"/>
                                        </radialGradient>
                                    </defs>
                                    <g>
                                        <path d="M1390 5024 c-163 -9 -239 -19 -315 -38 -281 -70 -477 -177 -660 -361 -184 -184 -292 -380 -361 -660 -43 -171 -53 -456 -53 -1445 0 -989 10 -1274 53 -1445 69 -280 177 -476 361 -660 184 -184 380 -292 660 -361 171 -43 456 -53 1445 -53 989 0 1274 10 1445 53 280 69 476 177 660 361 184 184 292 380 361 660 43 171 53 456 53 1445 0 989 -10 1274 -53 1445 -69 280 -177 476 -361 660 -184 184 -380 292 -660 361 -174 44 -454 53 -1470 52 -599 0 -960 -5 -1105 -14z m2230 -473 c58 -6 141 -18 185 -27 397 -78 638 -318 719 -714 37 -183 41 -309 41 -1290 0 -981 -4 -1107 -41 -1290 -81 -395 -319 -633 -714 -714 -183 -37 -309 -41 -1290 -41 -981 0 -1107 4 -1290 41 -397 81 -636 322 -714 719 -33 166 -38 296 -43 1100 -5 796 3 1203 27 1380 67 489 338 758 830 825 47 7 162 15 255 20 250 12 1907 4 2035 -9z"/>
                                        <path d="M2355 3819 c-307 -42 -561 -172 -780 -400 -244 -253 -359 -543 -359 -899 0 -361 116 -648 367 -907 262 -269 563 -397 937 -397 374 0 675 128 937 397 251 259 367 546 367 907 0 361 -116 648 -367 907 -197 203 -422 326 -690 378 -101 20 -317 27 -412 14z m400 -509 c275 -88 470 -284 557 -560 20 -65 23 -95 23 -230 0 -135 -3 -165 -23 -230 -88 -278 -284 -474 -562 -562 -65 -20 -95 -23 -230 -23 -135 0 -165 3 -230 23 -278 88 -474 284 -562 562 -20 65 -23 95 -23 230 0 135 3 165 23 230 73 230 219 403 427 507 134 67 212 83 390 79 111 -3 155 -8 210 -26z"/>
                                        <path d="M3750 1473 c-29 -11 -66 -38 -106 -77 -70 -71 -94 -126 -94 -221 0 -95 24 -150 94 -221 72 -71 126 -94 225 -94 168 0 311 143 311 311 0 99 -23 154 -94 225 -43 42 -76 66 -110 77 -61 21 -166 21 -226 0z"/>
                                    </g>
                                </svg>
                            </a>
                        </div>
                        <div class="mediaContainer">
                            <a href="<%- lang('landing.mediaYouTubeURL') %>" class="mediaURL" id="youtubeURL">
                                <svg id="youtubeSVG" class="mediaSVG" viewBox="35.34 34.3575 70.68 68.71500">
                                    <g>
                                        <path d="M84.8,69.52,65.88,79.76V59.27Zm23.65.59c0-5.14-.79-17.63-3.94-20.57S99,45.86,73.37,45.86s-28,.73-31.14,3.68S38.29,65,38.29,70.11s.79,17.63,3.94,20.57,5.52,3.68,31.14,3.68,28-.74,31.14-3.68,3.94-15.42,3.94-20.57"/>
                                    </g>
                                </svg>
                            </a>
                        </div>
                        <div class="mediaContainer">
                            <a href="<%- lang('landing.mediaDiscordURL') %>" class="mediaURL" id="discordURL">
                                <svg id="discordSVG" class="mediaSVG" viewBox="35.34 34.3575 70.68 68.71500">
                                    <g>
                                        <path d="M81.23,78.48a6.14,6.14,0,1,1,6.14-6.14,6.14,6.14,0,0,1-6.14,6.14M60,78.48a6.14,6.14,0,1,1,6.14-6.14A6.14,6.14,0,0,1,60,78.48M104.41,73c-.92-7.7-8.24-22.9-8.24-22.9A43,43,0,0,0,88,45.59a17.88,17.88,0,0,0-8.38-1.27l-.13,1.06a23.52,23.52,0,0,1,5.8,1.95,87.59,87.59,0,0,1,8.17,4.87s-10.32-5.63-22.27-5.63a51.32,51.32,0,0,0-23.2,5.63,87.84,87.84,0,0,1,8.17-4.87,23.57,23.57,0,0,1,5.8-1.95l-.13-1.06a17.88,17.88,0,0,0-8.38,1.27,42.84,42.84,0,0,0-8.21,4.56S37.87,65.35,37,73s-.37,11.54-.37,11.54,4.22,5.68,9.9,7.14,7.7,1.47,7.7,1.47l3.75-4.68a21.22,21.22,0,0,1-4.65-2A24.47,24.47,0,0,1,47.93,82S61.16,88.4,70.68,88.4c10,0,22.75-6.44,22.75-6.44a24.56,24.56,0,0,1-5.35,4.56,21.22,21.22,0,0,1-4.65,2l3.75,4.68s2,0,7.7-1.47,9.89-7.14,9.89-7.14.55-3.85-.37-11.54"/>
                                    </g>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="heroBlock">
        <div id="serverHero">
            <span id="serverHeroLabel"><%- lang('landing.serverHeroLabel') %></span>
            <span id="serverHeroName"><%- lang('landing.serverHeroLoading') %></span>
            <div id="serverHeroMeta">
                <span class="heroChip" id="serverHeroVersion"></span>
                <span class="heroChip" id="serverHeroLoader"></span>
                <span class="heroChip" id="serverHeroRevision"></span>
                <span class="heroChip" id="serverHeroRunning" hidden><%- lang('landing.gameRunning') %></span>
                <span class="heroChip" id="serverHeroUpdate" hidden></span>
            </div>
        </div>
        <div id="heroFooter">
            <div id="statusCard">
                <div id="server_status_wrapper">
                    <span id="player_count"><%- lang('landing.serverStatusPlaceholder') %></span>
                </div>
            </div>
        </div>
    </div>
    <div id="packUpdateToast" role="status" aria-live="polite" hidden>
        <svg class="packUpdateIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
        <div class="packUpdateBody">
            <span class="packUpdateTitle"></span>
            <span class="packUpdateText"></span>
            <button class="packUpdateOpen"><%- lang('landing.packUpdateOpen') %></button>
        </div>
        <button class="packUpdateClose" aria-label="<%- lang('landing.packUpdateClose') %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
    </div>
    <div id="serverDial" tabindex="0" role="listbox" aria-label="<%- lang('landing.serverDialLabel') %>">
        <svg id="serverDialRing" viewBox="0 0 520 180" aria-hidden="true">
            <circle cx="260" cy="372" r="300"/>
            <g id="serverDialTicks">
                <path id="serverDialTicksMinor"/>
                <path id="serverDialTicksMajor"/>
            </g>
        </svg>
        <div id="serverDialTiles">
            <!-- Server tiles are populated here. -->
        </div>
        <div id="serverDialNav">
            <button id="serverDialPrev" class="serverDialArrow" tabindex="-1" aria-label="<%- lang('landing.serverDialPrev') %>">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <div id="serverDialCaption">
                <span id="serverDialName"></span>
                <span id="serverDialPos"></span>
            </div>
            <button id="serverDialNext" class="serverDialArrow" tabindex="-1" aria-label="<%- lang('landing.serverDialNext') %>">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </button>
        </div>
    </div>
    <div id="launchArea">
        <div id="serverPicker">
            <button id="server_select" aria-haspopup="listbox" aria-expanded="false" aria-label="<%- lang('landing.serverPickerLabel') %>">
                <span id="serverPickerTile" class="serverListTile"></span>
                <span class="serverListText">
                    <span id="serverPickerName" class="serverListName"><%- lang('landing.launchButtonPlaceholder') %></span>
                    <span id="serverPickerMeta" class="serverListMeta"></span>
                </span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
            </button>
            <div id="serverMenu" role="listbox" tabindex="-1" aria-label="<%- lang('landing.serverDialLabel') %>">
                <div class="serverMenuHeading"><%- lang('landing.serverMenuHeading') %></div>
                <div id="serverMenuList">
                    <!-- Server rows are populated here. -->
                </div>
            </div>
        </div>
        <button id="launch_button">
            <span id="launch_content">
                <span class="launchLabel" id="launchButtonLabel"><%- lang('landing.launchButton') %></span>
            </span>
            <span id="launch_details">
                <span class="launchLabel"><%- lang('landing.launchingButton') %></span>
                <span class="launchSub" id="launch_progress_label">0%</span>
            </span>
            <!-- Launch progress, drawn around the pill (see setLaunchPercentage). -->
            <svg id="launch_progress" aria-hidden="true">
                <path class="launchRingTrack"/>
                <path class="launchRingFill" pathLength="100"/>
            </svg>
        </button>
        <!-- What the launch is doing, under the picker and the button. -->
        <div id="launchStatus" role="status" aria-live="polite">
            <span id="launch_details_text"><%- lang('landing.launchDetails') %></span>
        </div>
    </div>
    <aside id="newsContainer" aria-label="<%- lang('landing.newsDrawerTitle') %>">
        <div id="newsHeader">
            <div id="newsHeaderText">
                <h2><%- lang('landing.newsDrawerTitle') %></h2>
                <span><%- lang('landing.newsDrawerDesc') %></span>
            </div>
            <button id="newsClose" aria-label="<%- lang('landing.newsClose') %>">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
        </div>
        <div id="newsContent" style="display: none;">
            <div id="newsList"></div>
            <div id="newsArticleView" style="display: none;">
                <button id="newsBack">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                    <span><%- lang('landing.newsBack') %></span>
                </button>
                <div id="newsArticleScroll">
                    <article id="newsArticle"></article>
                </div>
            </div>
        </div>
        <div id="newsErrorContainer">
            <div id="newsErrorLoading">
                <span id="nELoadSpan" class="newsErrorContent"><%- lang('landing.newsErrorLoadSpan') %></span>
            </div>
            <div id="newsErrorFailed" style="display: none;">
                <span id="nEFailedSpan" class="newsErrorContent"><%- lang('landing.newsErrorFailedSpan') %></span>
                <button id="newsErrorRetry"><%- lang('landing.newsErrorRetryButton') %></button>
            </div>
            <div id="newsErrorNone" style="display: none;">
                <span id="nENoneSpan" class="newsErrorContent"><%- lang('landing.newsErrorNoneSpan') %></span>
            </div>
        </div>
    </aside>
    <script src="./assets/js/scripts/landing.js"></script>
</div>
