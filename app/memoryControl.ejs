<div class="memoryControl" id="<%= id %>">
    <div class="memoryRows">
        <div class="memoryRow">
            <span class="memoryRowTitle"><%- lang('settings.maxRAM') %></span>
            <div class="rangeSlider" data-ram="max" min="1" max="8" value="4" step="0.5">
                <div class="rangeSliderBar"></div>
                <div class="rangeSliderTrack"></div>
            </div>
            <span class="memoryRowValue" data-ram-label="max"></span>
        </div>
        <div class="memoryRow">
            <span class="memoryRowTitle"><%- lang('settings.minRAM') %></span>
            <div class="rangeSlider" data-ram="min" min="1" max="8" value="4" step="0.5">
                <div class="rangeSliderBar"></div>
                <div class="rangeSliderTrack"></div>
            </div>
            <span class="memoryRowValue" data-ram-label="min"></span>
        </div>
    </div>
    <div class="memoryStatus">
        <div class="memoryStatusItem">
            <span class="memoryStatusTitle"><%- lang('settings.memoryTotalTitle') %></span>
            <span class="memoryStatusValue" data-ram-total></span>
        </div>
        <div class="memoryStatusItem">
            <span class="memoryStatusTitle"><%- lang('settings.memoryAvailableTitle') %></span>
            <span class="memoryStatusValue" data-ram-free></span>
        </div>
    </div>
</div>
